# ============================================================
# .gitignore — dockerconfig 目录
# ============================================================

# 真实环境变量文件（含密钥，禁止入库）
.env
.env.local
.env.production

# Nginx 运行日志
nginx/logs/

# MySQL 持久化数据（由 Docker Volume 管理）
mysql/data/

# Redis 持久化数据
redis/data/
