# ============================================================
# 环境变量模板 — 复制为 .env 并填入真实值
# 注意：.env 文件禁止提交到 Git 仓库
# ============================================================

# ── 应用环境 ─────────────────────────────────────────────────
APP_ENV=local           # local | production
APP_DEBUG=true          # 生产改为 false
APP_KEY=                # 由 php artisan key:generate 生成

# ── 数据库 ───────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=rootsecret_change_me
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=dietitian
DB_USERNAME=dietitian
DB_PASSWORD=secret_change_me

# Production host ports for host-level Nginx -> Docker PHP-FPM.
PHP_FPM_HOST_PORT=127.0.0.1:9001
MINIAPP_PHP_FPM_HOST_PORT=127.0.0.1:9002

# ── Redis ────────────────────────────────────────────────────
REDIS_PASSWORD=         # 留空表示无密码（生产务必设置）

# ── 腾讯云 COS（图片/文件存储）──────────────────────────────
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-guangzhou
COS_BUCKET=

# ── 微信小程序 ───────────────────────────────────────────────
FPXXL_WECHAT_APP_ID=
FPXXL_WECHAT_APP_SECRET=
# Compatible fallback names:
# WECHAT_APP_ID=
# WECHAT_APP_SECRET=

# ── Vue3 管理后台构建 ─────────────────────────────────────────
VITE_API_BASE_URL=http://api.dietitian.local/api/v1

# Cloudflare R2
R2_ACCOUNT_ID=b9e8f20ffe4e2a8d9207760128e67b89
R2_ACCESS_KEY_ID=8ffefd3440a08a69311d624760b25e17
R2_SECRET_ACCESS_KEY=fdacbe6a824659f9bad65b2fdd596c9f7dba393e0c11c4ca8c0986bd2ea9e499
R2_BUCKET=dietitian
R2_REGION=auto
R2_ENDPOINT=https://b9e8f20ffe4e2a8d9207760128e67b89.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-43eb3abcfd034a5abdf7e76236e4d02a.r2.dev
