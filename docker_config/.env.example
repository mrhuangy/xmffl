MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=fpxxl
MYSQL_USER=fpxxl
MYSQL_PASSWORD=fpxxl
MYSQL_DSN=fpxxl:fpxxl@tcp(mysql:3306)/fpxxl?parseTime=true&loc=Local

MYSQL_PORT=3306
BACKEND_PORT=8080
MINIGAME_API_PORT=8090
ADMIN_PORT=5173
NGINX_HTTP_PORT=80

ALLOW_ORIGIN=*
ADMIN_JWT_SECRET=replace-with-a-long-random-secret
GIN_MODE=release

WECHAT_MINIGAME_APPID=
WECHAT_MINIGAME_SECRET=

# Local domains handled by docker_config/deploy/nginx/conf.d/default.conf:
# 127.0.0.1 fpxxl.local admin.fpxxl.local api.fpxxl.local minigame-api.fpxxl.local game-api.fpxxl.local
